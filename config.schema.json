{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ETF Wallpaper settings",
  "type": "object",
  "required": [
    "assets"
  ],
  "properties": {
    "manual_accounts": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "enum": [
              "isa",
              "irp"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "currency": {
            "const": "KRW"
          },
          "as_of": {
            "type": "string",
            "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "cash": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "contribution": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "cash_target_percent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "drift_threshold_pp": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "holdings": {
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "object",
              "required": [
                "symbol",
                "value"
              ],
              "properties": {
                "symbol": {
                  "type": "string",
                  "pattern": "^[A-Z0-9][A-Z0-9.\\-]{0,29}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "quantity": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000000000000
                },
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000000
                },
                "target_percent": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "currency": {
      "const": "USD"
    },
    "account": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "profile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        }
      }
    },
    "refresh_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600
    },
    "indicators": {
      "type": "object",
      "properties": {
        "rsi_period": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "history_range": {
          "enum": [
            "6mo",
            "1y",
            "2y",
            "5y",
            "10y",
            "max"
          ]
        }
      }
    },
    "rebalance": {
      "type": "object",
      "properties": {
        "position_targets": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          }
        },
        "cash_target_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "drift_threshold_pp": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "cash_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "contribution_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000000
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "symbol"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z0-9^][A-Z0-9.^=\\-]{0,29}$"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "category": {
            "type": "string",
            "maxLength": 100
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "target_percent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "quantity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000000
          }
        }
      }
    },
    "dip_strategy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "signal_symbol": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9.\\-]{0,29}$"
        },
        "lookback_sessions": {
          "type": "integer",
          "minimum": 20,
          "maximum": 500
        },
        "starting_cash_krw": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000000.0
        },
        "cash_adjustment_krw": {
          "type": "number",
          "minimum": -1000000000000000.0,
          "maximum": 1000000000000000.0
        },
        "spend_remaining_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "levels_percent": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 100
          }
        },
        "executions": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": [
              "cycle",
              "level_percent",
              "amount_krw",
              "date"
            ],
            "properties": {
              "cycle": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "level_percent": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 100
              },
              "amount_krw": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000000000000.0
              },
              "date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    }
  }
}
