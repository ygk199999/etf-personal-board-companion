{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ETF Wallpaper settings",
  "type": "object",
  "required": ["assets"],
  "properties": {
    "$schema": {"type": "string"},
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "currency": {"const": "USD"},
    "refresh_seconds": {"type": "integer", "minimum": 60, "maximum": 3600},
    "indicators": {"type": "object", "properties": {
      "rsi_period": {"type": "integer", "minimum": 2, "maximum": 100},
      "history_range": {"enum": ["6mo", "1y", "2y", "5y", "10y", "max"]}
    }},
    "rebalance": {"type": "object", "properties": {
      "cash_target_percent": {"type": "number", "minimum": 0, "maximum": 100},
      "drift_threshold_pp": {"type": "number", "minimum": 0, "maximum": 100},
      "cash_usd": {"type": "number", "minimum": 0, "maximum": 1000000000000000},
      "contribution_usd": {"type": "number", "minimum": 0, "maximum": 1000000000000000}
    }},
    "assets": {"type": "array", "minItems": 1, "maxItems": 24, "items": {
      "type": "object", "required": ["symbol"], "properties": {
        "symbol": {"type": "string", "pattern": "^[A-Z0-9^][A-Z0-9.^=\\-]{0,29}$"},
        "name": {"type": "string", "maxLength": 100},
        "category": {"type": "string", "maxLength": 100},
        "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "target_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "quantity": {"type": "number", "minimum": 0, "maximum": 1000000000000000}
      }
    }}
  }
}
